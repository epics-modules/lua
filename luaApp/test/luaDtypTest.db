# Test databases for DTYP "lua" device support

record(ai, "$(P)ai") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_double(42.5)")
    field(SCAN, "Passive")
}

record(ao, "$(P)ao") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(SCAN, "Passive")
}

record(bi, "$(P)bi") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_one")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SCAN, "Passive")
}

record(bo, "$(P)bo") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SCAN, "Passive")
}

record(longin, "$(P)longin") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_int(100)")
    field(SCAN, "Passive")
}

record(longout, "$(P)longout") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(SCAN, "Passive")
}

record(mbbi, "$(P)mbbi") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_int(2)")
    field(ZRST, "Zero")
    field(ONST, "One")
    field(TWST, "Two")
    field(THST, "Three")
    field(SCAN, "Passive")
}

# mbbi with defined state values to test RVAL->VAL conversion
record(mbbi, "$(P)mbbi_rval") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_int(2)")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(ZRST, "Zero")
    field(ONST, "One")
    field(TWST, "Two")
    field(SCAN, "Passive")
}

record(mbbo, "$(P)mbbo") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(ZRST, "Zero")
    field(ONST, "One")
    field(TWST, "Two")
    field(SCAN, "Passive")
}

record(mbbiDirect, "$(P)mbbiDirect") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_bits")
    field(NOBT, "4")
    field(SCAN, "Passive")
}

record(mbboDirect, "$(P)mbboDirect") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(NOBT, "4")
    field(SCAN, "Passive")
}

record(stringin, "$(P)stringin") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_string")
    field(SCAN, "Passive")
}

record(stringout, "$(P)stringout") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(SCAN, "Passive")
}

record(lsi, "$(P)lsi") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_longstring")
    field(SIZV, "256")
    field(SCAN, "Passive")
}

record(lso, "$(P)lso") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua write_noop")
    field(SIZV, "256")
    field(SCAN, "Passive")
}

record(waveform, "$(P)wf_double") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_double_array")
    field(FTVL, "DOUBLE")
    field(NELM, "10")
    field(SCAN, "Passive")
}

record(waveform, "$(P)wf_string") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_string_array")
    field(FTVL, "STRING")
    field(NELM, "10")
    field(SCAN, "Passive")
}

record(aai, "$(P)aai_int") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_int_array")
    field(FTVL, "LONG")
    field(NELM, "10")
    field(SCAN, "Passive")
}

record(aao, "$(P)aao_double") {
    field(DTYP, "lua")
    field(OUT,  "@luaDtypTest.lua capture_array")
    field(FTVL, "DOUBLE")
    field(NELM, "10")
    field(SCAN, "Passive")
}

# Test bi with string return matching ONAM
record(bi, "$(P)bi_str") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_on_string")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SCAN, "Passive")
}

# Test: Lua function that errors -- should raise READ_ALARM
record(ai, "$(P)ai_err") {
    field(DTYP, "lua")
    field(INP,  "@luaDtypTest.lua read_error")
    field(SCAN, "Passive")
}
